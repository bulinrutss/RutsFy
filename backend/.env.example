# YouTube Data API v3 — principal; ao esgotar cota, usa YOUTUBE_API_KEYS em ordem.
YOUTUBE_API_KEY=sua_chave_aqui
# 2ª, 3ª, 4ª… chaves (separadas por vírgula): chave2,chave3,chave4
YOUTUBE_API_KEYS=
HOST=0.0.0.0
PORT=8090
CORS_ORIGINS=*
# Pasta (no servidor) onde ficam áudios, library.json, quota.json e cache da API (youtube_api_cache/)
DOWNLOADS_DIR=downloads
# Opcional: caminho fixo do binário yt-dlp (vazio = autodetectar)
YTDLP_BIN=
# Netscape cookies para yt-dlp na VPS (anti-bot). Relativo a DOWNLOADS_DIR.
YTDLP_COOKIES_FILE=youtube_cookies.txt
# Opcional: limite diário de unidades da API v3 (padrão do Google: 10.000)
YOUTUBE_DAILY_QUOTA=10000
# Novas buscas (1ª página) por conta por dia (padrão 20).
USER_SEARCH_DAILY_LIMIT=20
# Buscas por dia ilimitadas (vírgula): apelidos e/ou e-mails de contas antigas.
USER_SEARCH_UNLIMITED_NICKNAMES=svbulin
USER_SEARCH_UNLIMITED_EMAILS=svbulin@gmail.com
# Bitrate do áudio salvo (Opus). 64K é o padrão (menor). 96K se quiser mais qualidade.
AUDIO_BITRATE=64K
# Oracle: lan_relay + worker na LAN; local: yt-dlp nesta máquina.
DOWNLOAD_MODE=local
# Token compartilhado com scripts/lan_download_worker.py (Bearer).
LAN_DOWNLOAD_WORKER_TOKEN=